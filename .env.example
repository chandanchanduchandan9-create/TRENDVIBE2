# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project
SUPABASE_URL="https://ovdgiwothbuxthjczrkp.supabase.co"

# SUPABASE_ANON_KEY: The publishable anon key for Supabase
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# RAZORPAY PAYMENT GATEWAY
# Public Key ID for browser checkout popup
RAZORPAY_KEY_ID="rzp_test_TtkEQU3nkvP1Lf"
VITE_RAZORPAY_KEY_ID="rzp_test_TtkEQU3nkvP1Lf"
# Private Key Secret: strictly server-side for order creation & HMAC-SHA256 signature verification
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# DEEPGRAM SPEECH-TO-TEXT API
# Used for high-accuracy voice recognition across all devices and languages
DEEPGRAM_API_KEY="YOUR_DEEPGRAM_API_KEY"

# MONGODB COMPASS PERSISTENT DATABASE
# Optional connection URI (e.g. mongodb://localhost:27017 or MongoDB Atlas connection string)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="trendvibe"

# AMAZON PRODUCT ADVERTISING API (PA-API v5)
# Access real-time product data, pricing, and images from Amazon Associate account
AMAZON_PAAPI_ACCESS_KEY="YOUR_ACCESS_KEY"
AMAZON_PAAPI_SECRET_KEY="YOUR_SECRET_KEY"
AMAZON_PAAPI_PARTNER_TAG="yourtag-20"
AMAZON_PAAPI_MARKETPLACE="www.amazon.in"

# ELEVENLABS CONVERSATIONAL AI CONFIGURATION
# High-fidelity conversational AI and low-latency voice streaming
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"
ELEVENLABS_AGENT_ID="agent_9401m63qfb47fe3atajs7ccv9xsb"
VITE_ELEVENLABS_AGENT_ID="agent_9401m63qfb47fe3atajs7ccv9xsb"




