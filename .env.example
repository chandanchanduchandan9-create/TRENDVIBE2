# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of your Supabase project
SUPABASE_URL="https://ovdgiwothbuxthjczrkp.supabase.co"

# SUPABASE_ANON_KEY: The publishable anon key for Supabase
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# RETELL AI VOICE AGENT WIDGET CONFIGURATION
# Connects the floating "Talk to Zyro AI" button to Retell AI voice agent.
# Public Key is safe for client-side frontend browsers (https://docs.retellai.com/deploy/chat-widget).
# SECURITY NOTE: Do NOT place your private Retell API Key or Supabase service-role key in frontend client variables.
VITE_RETELL_VOICE_AGENT_ID="agent_ece378b00dfe71918f6180d5d2"
VITE_RETELL_VOICE_PUBLIC_KEY="llm_6bdd716e07388af506d2e8a2c357"

# RAZORPAY PAYMENT GATEWAY
# Public Key ID for browser checkout popup
RAZORPAY_KEY_ID="rzp_test_TtkEQU3nkvP1Lf"
VITE_RAZORPAY_KEY_ID="rzp_test_TtkEQU3nkvP1Lf"
# Private Key Secret: strictly server-side for order creation & HMAC-SHA256 signature verification
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# DEEPGRAM SPEECH-TO-TEXT API
# Used for high-accuracy voice recognition across all devices and languages
DEEPGRAM_API_KEY="YOUR_DEEPGRAM_API_KEY"

# MONGODB COMPASS PERSISTENT DATABASE
# Optional connection URI (e.g. mongodb://localhost:27017 or MongoDB Atlas connection string)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="trendvibe"
